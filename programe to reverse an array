//programe to check if a string is pollindrome 
#include<stdio.h>
void reversearray(int *arr,int n){
    int *start=arr,*end=arr+n-1,temp;
    while(start<end){
        temp=*start;
        *start=*end;
        *end=temp;
        start++;
        end--;
    }
}
int main(){
int n;
printf("enter the number of elements");
scanf("%d",&n);
int arr[n];
printf("enter the elements:");
for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
}
reversearray(arr,n);
printf("revesred array");
for(int i=0;i<n;i++){
    printf("%d",arr[i]);
}
return 0;
}
