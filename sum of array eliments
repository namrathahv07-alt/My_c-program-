// Online C compiler to run C program online
#include <stdio.h>
int main() {
    int n,sum=0;
    printf("enter the number of eliments");
    scanf("%d\n",&n);
    int arr[n];
    printf("enter the elements");
    for (int i=0;i<n;i++){
        scanf("%d",&arr[i]);
        sum+=arr[i];
    }
    printf("sum=%d\n",sum);
    return 0;
}
   
